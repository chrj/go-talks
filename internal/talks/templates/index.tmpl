{{/*
This is the landing page. It lists the talks, grouped by the first element of
their path, which is the year.
*/}}

{{define "index"}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{.Title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/static/favicon.ico">
    <style>
      :root {
        color-scheme: light dark;
        --fg: #222;
        --dim: #666;
        --bg: #fff;
        --accent: #007d9c;
      }
      @media (prefers-color-scheme: dark) {
        :root { --fg: #e6e6e6; --dim: #9a9a9a; --bg: #16191d; --accent: #4fc3dc; }
      }
      body {
        margin: 0 auto;
        padding: 3rem 1.5rem;
        max-width: 42rem;
        background: var(--bg);
        color: var(--fg);
        font: 1rem/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      h1 { font-size: 1.8rem; margin: 0 0 .5rem; }
      h2 { font-size: 1rem; margin: 2.5rem 0 .75rem; color: var(--dim); font-weight: 600; }
      p.intro { color: var(--dim); margin: 0 0 1rem; }
      ul { list-style: none; margin: 0; padding: 0; }
      li { margin: 0 0 1rem; }
      a { color: var(--accent); text-decoration: none; }
      a:hover, a:focus { text-decoration: underline; }
      .subtitle { display: block; color: var(--dim); font-size: .9rem; }
      footer { margin-top: 3rem; color: var(--dim); font-size: .85rem; }
    </style>
  </head>
  <body>
    <h1>{{.Title}}</h1>
    <p class="intro">Talks I have given on Go.</p>
    {{range .Groups}}
    <h2>{{.Name}}</h2>
    <ul>
      {{range .Talks}}
      <li>
        <a href="/{{.Page}}">{{.Title}}</a>
        {{with .Subtitle}}<span class="subtitle">{{.}}</span>{{end}}
      </li>
      {{end}}
    </ul>
    {{end}}
    <footer>
      <a href="{{.Repository}}">Source on GitHub</a>
    </footer>
  </body>
</html>
{{end}}
