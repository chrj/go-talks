{{/*
This is the slide template. It renders one presentation as a single page.

The file starts from cmd/present/templates/slides.tmpl in golang.org/x/tools.
It drops the analytics code and the presenter notes of the upstream file, and
it loads the playground from /static/play.js, which the render command writes.
*/}}

{{define "root"}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{.Title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/static/favicon.ico">
    {{/* slides.js reads this variable before it starts. */}}
    <script>
      var notesEnabled = {{.NotesEnabled}};
    </script>
    <script src="/static/slides.js"></script>
  </head>

  {{/* slides.js shows the body after it lays the slides out. */}}
  <body style="display: none">

    <section class="slides layout-widescreen">

      <article>
        <h1>{{.Title}}</h1>
        {{with .Subtitle}}<h3>{{.}}</h3>{{end}}
        {{if not .Time.IsZero}}<h3>{{.Time.Format "2 January 2006"}}</h3>{{end}}
        {{range .Authors}}
          <div class="presenter">
            {{range .TextElem}}{{elem $.Template .}}{{end}}
          </div>
        {{end}}
      </article>

  {{range $i, $s := .Sections}}
      <article {{$s.HTMLAttributes}}>
      {{if $s.Elem}}
        <h3>{{$s.Title}}</h3>
        {{range $s.Elem}}{{elem $.Template .}}{{end}}
      {{else}}
        <h2>{{$s.Title}}</h2>
      {{end}}
      <span class="pagenumber">{{pagenum $s 1}}</span>
      </article>
  {{end}}

      <article>
        <h3>Thank you</h3>
        {{range .Authors}}
          <div class="presenter">
            {{range .Elem}}{{elem $.Template .}}{{end}}
          </div>
        {{end}}
        <p class="link"><a href="/">All talks</a></p>
      </article>

    </section>

    <div id="help">
      Use the left and right arrow keys or click the left and right
      edges of the page to navigate between slides.<br>
      (Press 'H' or navigate to hide this message.)
    </div>

    {{if .PlayEnabled}}
    <script src="/static/play.js"></script>
    {{end}}
  </body>
</html>
{{end}}

{{define "newline"}}
<br>
{{end}}
